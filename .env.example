# Copy this file to .env.local and fill in the values.
# Leave NEXT_PUBLIC_GOOGLE_FORM_URL empty to show "Pilot registration opens soon".

# The published Google Form link (the "viewform" link from Send > Link)
NEXT_PUBLIC_GOOGLE_FORM_URL=

# Prefill field IDs (optional). Get them from: Form > three dots > "Get pre-filled link".
# Use just the number, e.g. 1234567890 (the "entry." prefix is added for you).
# If these are empty, the general form opens and people choose their options there.
NEXT_PUBLIC_FORM_ENTRY_PARTICIPATION=
NEXT_PUBLIC_FORM_ENTRY_HELP_PREFERENCE=

# Public site URL (used for social-share metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
